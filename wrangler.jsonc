{
  "name": "gains-app",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gains-db",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ]
}
